    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"form\" TEXT NOT NULL, \"dose_amount\" REAL NULL, \"dose_unit\" TEXT NULL, \"type_kind\" TEXT NOT NULL, \"frequency\" TEXT NOT NULL, \"start_date\" INTEGER NOT NULL, \"duration_days\" INTEGER NULL, \"pause_days\" INTEGER NULL, \"stock_remaining\" INTEGER NULL, \"stock_total\" INTEGER NULL, \"stock_warn_at\" INTEGER NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "time_slots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"time_slots\" (\"id\" TEXT NOT NULL, \"medication_id\" TEXT NOT NULL REFERENCES medications (id) ON DELETE CASCADE, \"minute_of_day\" INTEGER NOT NULL, \"dose_amount\" REAL NULL, \"dose_unit\" TEXT NULL, PRIMARY KEY (\"id\"));"
